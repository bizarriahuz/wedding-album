{
  // Isolated load-test stack. Same code as production, separate Worker, D1 and R2.
  // Never point these bindings at wedding-album / wedding-album-media.
  "name": "madeofmemories-loadtest",
  "main": "./worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/e/*", "/admin/*", "/print/*", "/demo"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "wedding-album-loadtest", "database_id": "77b85ecc-caeb-4655-8e5a-45e20e474dfb" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "wedding-album-media-loadtest" }
  ],
  "observability": { "enabled": true }
}
